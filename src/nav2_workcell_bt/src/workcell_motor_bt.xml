<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="MainSequence">

      <!-- Navigation vers la cible -->
      <NavigateToPose goal="{goal_pose}" />

      <!-- Une fois arrivé, activer le moteur si on entre dans un workcell -->
      <IsInWorkcell workcell_name="{workcell_name}" />
      <MotorRotate command="on" />

      <!-- Boucle : tant qu'on est dans le workcell -->
      <WhileDoElse condition="IsInWorkcell" condition_args="workcell_name={workcell_name}">
        <Do>
          <!-- Actions répétées tant que le robot reste DANS le workcell -->
          <TickOnce/>
        </Do>
        <Else>
          <!-- Dès que le robot sort du workcell -->
          <MotorRotate command="off" />
        </Else>
      </WhileDoElse>

    </Sequence>
  </BehaviorTree>
</root>


