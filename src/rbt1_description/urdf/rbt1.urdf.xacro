<?xml version="1.0"?>
<robot name="rbt1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="materials.xacro" />
  <xacro:include filename="macros.xacro" />
  <xacro:include filename="rbt1_transmissions.xacro" />
  <xacro:include filename="rbt1_ros2_control.xacro" />

  <!-- Parameters -->
  <xacro:property name="wheel_radius" value="0.11"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_sep"    value="0.38"/>

  
  
  <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
    </joint>

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.45 0.35 0.20"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.45 0.35 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia
        ixx="0.2"
        ixy="0.0"
        ixz="0.0"
        iyy="0.2"
        iyz="0.0"
        izz="0.3"/>
    </inertial>
  </link>


  <!-- Left wheel -->
  <xacro:wheel_macro name="left_wheel"
                     parent="base_link"
                     radius="${wheel_radius}"
                     width="${wheel_width}"
                     y_offset="${wheel_sep/2}"/>

  <!-- Right wheel -->
  <xacro:wheel_macro name="right_wheel"
                     parent="base_link"
                     radius="${wheel_radius}"
                     width="${wheel_width}"
                     y_offset="-${wheel_sep/2}"/>

  <!-- ros2_control -->
  <xacro:rbt1_ros2_control wheel_radius="${wheel_radius}"
                            wheel_separation="${wheel_sep}"/>

</robot>

