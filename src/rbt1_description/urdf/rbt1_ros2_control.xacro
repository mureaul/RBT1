<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rbt1_ros2_control" params="wheel_radius wheel_separation">

    <ros2_control name="rbt1_control" type="system">
      <hardware>
        <plugin>rbt1_control/RBT1HWInterface</plugin>
        <param name="left_step">17</param>
        <param name="left_dir">27</param>
        <param name="right_step">22</param>
        <param name="right_dir">23</param>
        <param name="steps_per_rev">200</param>
        <param name="wheel_radius">${wheel_radius}</param>
        <param name="max_accel_m_s2">4.0</param>
        <param name="pulse_us">50.0</param>
        <param name="max_step_frequency">20000.0</param>
      </hardware>

      <joint name="left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>

